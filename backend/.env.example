# PrivyDoc Backend Environment Configuration
APP_NAME=PrivyDoc
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Local SLM Runtime (Ollama default on localhost)
LOCAL_SLM_URL=http://127.0.0.1:11434
SLM_MODEL_NAME=qwen2.5:1.5b-instruct
SLM_TIMEOUT_SECONDS=5.0

# Session & Retention
MAX_UPLOAD_SIZE_MB=20
SESSION_TTL_HOURS=24
